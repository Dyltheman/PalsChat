rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairKey(firstUid, secondUid) {
      return firstUid < secondUid
        ? firstUid + '~' + secondUid
        : secondUid + '~' + firstUid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function friendRequestPath(firstUid, secondUid) {
      return /databases/$(database)/documents/friendRequests/$(pairKey(firstUid, secondUid));
    }

    function friendshipPath(firstUid, secondUid) {
      return /databases/$(database)/documents/friendships/$(pairKey(firstUid, secondUid));
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'displayName', 'username', 'photoURL', 'status', 'createdAt',
          'updatedAt', 'lastSeenAt'
        ])
        && data.keys().hasOnly([
          'displayName', 'username', 'photoURL', 'status', 'createdAt',
          'updatedAt', 'lastSeenAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 40
        && validUsername(data.username)
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.status is string
        && data.status.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    function usernameClaimExists(username, uid) {
      return existsAfter(usernamePath(username))
        && getAfter(usernamePath(username)).data.uid == uid;
    }

    function friendshipExists(firstUid, secondUid) {
      return exists(friendshipPath(firstUid, secondUid));
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(conversationPath(conversationId))
        && get(conversationPath(conversationId)).data.participantUids.hasAny([request.auth.uid]);
    }

    function validRequest(id, data) {
      return data.keys().hasAll([
          'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt'
        ])
        && data.senderUid is string
        && data.receiverUid is string
        && data.senderUid != data.receiverUid
        && id == pairKey(data.senderUid, data.receiverUid)
        && data.status in ['pending', 'accepted', 'declined', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && usernameClaimExists(request.resource.data.username, uid);

      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && usernameClaimExists(request.resource.data.username, uid);

      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == username;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username != username;
    }

    match /friendRequests/{requestId} {
      allow get, list: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.receiverUid == request.auth.uid);

      allow create: if signedIn()
        && validRequest(requestId, request.resource.data)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !friendshipExists(request.resource.data.senderUid, request.resource.data.receiverUid);

      allow update: if signedIn()
        && validRequest(requestId, request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'pending'
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.receiverUid == resource.data.receiverUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.auth.uid == resource.data.senderUid
            && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'pending'
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.receiverUid == resource.data.receiverUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.auth.uid == resource.data.receiverUid
            && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.status in ['declined', 'cancelled']
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.receiverUid != request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && !friendshipExists(request.resource.data.senderUid, request.resource.data.receiverUid))
        );

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow get, list: if signedIn()
        && resource.data.participantUids.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantUids', 'createdAt'])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] < request.resource.data.participantUids[1]
        && friendshipId == pairKey(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        )
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.createdAt == request.time
        && exists(friendRequestPath(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        ))
        && get(friendRequestPath(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        )).data.status == 'pending'
        && get(friendRequestPath(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        )).data.receiverUid == request.auth.uid
        && getAfter(friendRequestPath(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        )).data.status == 'accepted';

      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow get, list: if signedIn()
        && resource.data.participantUids.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantUids', 'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] < request.resource.data.participantUids[1]
        && conversationId == pairKey(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        )
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessagePreview == ''
        && friendshipExists(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        );

      allow update: if signedIn()
        && resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessageAt', 'lastMessagePreview'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 120;

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}